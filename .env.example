# ─────────────────────────────────────────────────────────────
# Fruites del Baix Llobregat — variables de entorno
# Copia este archivo a .env.local para desarrollo local.
# En producción, configúralas en Vercel → Project → Settings → Environment Variables.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública definitiva (sin barra final). Se usa en canonical, hreflang, sitemap y Open Graph.
# Mientras no exista el dominio definitivo, déjala vacía o con la URL de Vercel.
NEXT_PUBLIC_SITE_URL=https://www.fruitesbaixllobregat.com

# Indexación: solo "true" en el entorno Production de Vercel cuando el dominio definitivo esté conectado.
# En Preview / Development la web SIEMPRE es noindex, aunque esta variable valga "true".
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Formularios (proveedor de correo: Resend — https://resend.com) ──
# Si faltan, los formularios muestran un aviso con teléfono/email en lugar de simular un envío.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio verificado con SPF/DKIM), p. ej. "Web Fruites <web@fruitesbaixllobregat.com>"
FORMS_FROM_EMAIL=
# Destinatario general (confirmar con la empresa). Puede ser una lista separada por comas.
FORMS_TO_EMAIL=
# Destinatarios específicos opcionales; si se dejan vacíos se usa FORMS_TO_EMAIL.
FORMS_TO_EMAIL_BUYERS=
FORMS_TO_EMAIL_SUPPLIERS=

# ── Medición y buscadores (opcionales) ──
# Google Analytics 4 (solo se carga tras el consentimiento del usuario).
NEXT_PUBLIC_GA_ID=
# Códigos de verificación (meta tags). Alternativa: verificación por DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
